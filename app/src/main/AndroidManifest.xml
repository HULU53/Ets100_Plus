            android:exported="false"
            android:label="@string/app_name"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Fe.Transparent" />

        <activity
            android:name=".GeneralSettingsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Fe.Transparent" />

        <activity
            android:name=".TestFeature1Activity"
            android:exported="false"
            android:label="@string/app_name"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Fe.Transparent" />

        <activity
            android:name=".ThemeSettingsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Fe.Transparent" />

        <activity
            android:name=".LegalActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Fe.Transparent" />

        <activity
            android:name=".AnswerOpaqueActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Fe" />


        <activity
            android:name=".RemoteContentOpaqueActivity"
            android:exported="false"
